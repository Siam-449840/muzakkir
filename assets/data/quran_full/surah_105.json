{
  "surah": 105,
  "verses": [
    {
      "content_id": "quran_105_001",
      "reference": {
        "surah_number": 105,
        "surah_name": "Al-Fil",
        "surah_name_ar": "سُوْرَةُ الْفِيْلِ",
        "surah_name_translation": "The Elephant",
        "ayah_number": 1,
        "juz": 30,
        "revelation_type": "Mecca"
      },
      "arabic_word_count": 7,
      "translations": {
        "ar": {
          "text": "أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِأَصۡحَٰبِ ٱلۡفِيلِ",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "Have you not seen ˹O Prophet˺ how your Lord dealt with the Army of the Elephant",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "难道你不知道你的主怎样处治象的主人们吗？",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "क्या तुमने देखा नहीं कि तुम्हारे रब ने हाथीवालों के साथ कैसा बरताव किया",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "¿No has observado lo que hizo tu Señor con el ejército del elefante",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "N'as-tu pas vu comment ton Seigneur a agi envers les gens de l'Eléphant",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "আপনি কি দেখেননি আপনার পালনকর্তা হস্তীবাহিনীর সাথে কিরূপ ব্যবহার করেছেন?",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "Não viste como teu Senhor agiu com os donos do elefante",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "Разве ты не видел, что сделал твой Господь с владельцами слона",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "کیا تم نے نہیں دیکھا کہ تمہارے پروردگار نے ہاتھی والوں کے ساتھ کیا کیا",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_105_002",
      "reference": {
        "surah_number": 105,
        "surah_name": "Al-Fil",
        "surah_name_ar": "سُوْرَةُ الْفِيْلِ",
        "surah_name_translation": "The Elephant",
        "ayah_number": 2,
        "juz": 30,
        "revelation_type": "Mecca"
      },
      "arabic_word_count": 5,
      "translations": {
        "ar": {
          "text": "أَلَمۡ يَجۡعَلۡ كَيۡدَهُمۡ فِي تَضۡلِيلࣲ‏",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "Did He not frustrate their scheme",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "难道他没有使他们的计谋, 变成无益的吗？",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "क्या उसने उनकी चाल को अकारथ नहीं कर दिया",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "¿No has visto cómo desbarató sus planes [de destruir la Ka‘bah]",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "N'a-t-Il pas rendu leur ruse complètement vaine",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "তিনি কি তাদের চক্রান্ত নস্যাৎ করে দেননি?",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "Não fez Ele sua insídia ficar em descaminho",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "Разве Он не запутал их козни",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "کیا ان کا داؤں غلط نہیں کیا؟ (گیا)",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_105_003",
      "reference": {
        "surah_number": 105,
        "surah_name": "Al-Fil",
        "surah_name_ar": "سُوْرَةُ الْفِيْلِ",
        "surah_name_translation": "The Elephant",
        "ayah_number": 3,
        "juz": 30,
        "revelation_type": "Mecca"
      },
      "arabic_word_count": 4,
      "translations": {
        "ar": {
          "text": "وَأَرۡسَلَ عَلَيۡهِمۡ طَيۡرًا أَبَابِيلَ",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "For He sent against them flocks of birds",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "他曾派遣成群的鸟去伤他们",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "और उनपर नियुक्त होने को झुंड के झुंड पक्षी भेजे",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "Y envió sobre ellos bandadas de aves",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "et envoyé sur eux des oiseaux par volées",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "তিনি তাদের উপর প্রেরণ করেছেন ঝাঁকে ঝাঁকে পাখী,",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "E contra eles enviou pássaros, em bandos",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "и не наслал на них птиц стаями",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "اور ان پر جھلڑ کے جھلڑ جانور بھیجے",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_105_004",
      "reference": {
        "surah_number": 105,
        "surah_name": "Al-Fil",
        "surah_name_ar": "سُوْرَةُ الْفِيْلِ",
        "surah_name_translation": "The Elephant",
        "ayah_number": 4,
        "juz": 30,
        "revelation_type": "Mecca"
      },
      "arabic_word_count": 4,
      "translations": {
        "ar": {
          "text": "تَرۡمِيهِم بِحِجَارَةࣲ مِّن سِجِّيلࣲ‏",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "that pelted them with stones of baked clay",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "以粘土石射击他们",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "उनपर कंकरीले पत्थर मार रहे थे",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "que les arrojaron piedras de arcilla dura",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "qui leur lançaient des pierres d'argile",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "যারা তাদের উপর পাথরের কংকর নিক্ষেপ করছিল।",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "Que lhes atiravam pedras de sijjil",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "Они бросали в них каменья из обожженной глины",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "جو ان پر کھنگر کی پتھریاں پھینکتے تھے",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_105_005",
      "reference": {
        "surah_number": 105,
        "surah_name": "Al-Fil",
        "surah_name_ar": "سُوْرَةُ الْفِيْلِ",
        "surah_name_translation": "The Elephant",
        "ayah_number": 5,
        "juz": 30,
        "revelation_type": "Mecca"
      },
      "arabic_word_count": 3,
      "translations": {
        "ar": {
          "text": "فَجَعَلَهُمۡ كَعَصۡفࣲ مَّأۡكُولِۭ",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "leaving them like chewed up straw",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "使他们变成吃剩的干草一样。",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "अन्ततः उन्हें ऐसा कर दिया, जैसे खाने का भूसा हो",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "y los dejó como heno carcomido",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "Et Il les a rendus semblables à une paille mâchée",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "অতঃপর তিনি তাদেরকে ভক্ষিত তৃণসদৃশ করে দেন।",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "Então, tornou-os como folhas devoradas",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "и превратили их в подобие изъеденных иссохших злаковых листьев",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "تو ان کو ایسا کر دیا جیسے کھایا ہوا بھس",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    }
  ]
}