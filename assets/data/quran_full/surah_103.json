{
  "surah": 103,
  "verses": [
    {
      "content_id": "quran_103_001",
      "reference": {
        "surah_number": 103,
        "surah_name": "Al-Asr",
        "surah_name_ar": "سُوْرَةُ الْعَصْرِ",
        "surah_name_translation": "The Declining Day, Epoch",
        "ayah_number": 1,
        "juz": 30,
        "revelation_type": "Mecca"
      },
      "arabic_word_count": 1,
      "translations": {
        "ar": {
          "text": "وَٱلۡعَصۡرِ",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "By the ˹passage of˺ time",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "以时光盟誓，",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "गवाह है गुज़रता समय",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "Juro por el tiempo",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "Par le Temps",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "কসম যুগের (সময়ের),",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "Pelo tempo",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "Клянусь предвечерним временем (или временем)",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "عصر کی قسم",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_103_002",
      "reference": {
        "surah_number": 103,
        "surah_name": "Al-Asr",
        "surah_name_ar": "سُوْرَةُ الْعَصْرِ",
        "surah_name_translation": "The Declining Day, Epoch",
        "ayah_number": 2,
        "juz": 30,
        "revelation_type": "Mecca"
      },
      "arabic_word_count": 4,
      "translations": {
        "ar": {
          "text": "إِنَّ ٱلۡإِنسَٰنَ لَفِي خُسۡرٍ",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "Surely humanity is in ˹grave˺ loss",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "一切人确是在亏折之中，",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "कि वास्तव में मनुष्य घाटे में है",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "que los seres humanos están en la perdición",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "L'homme est certes, en perdition",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "নিশ্চয় মানুষ ক্ষতিগ্রস্ত;",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "Por certo, o ser humano está em perdição",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "Воистину, каждый человек в убытке",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "کہ انسان نقصان میں ہے",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_103_003",
      "reference": {
        "surah_number": 103,
        "surah_name": "Al-Asr",
        "surah_name_ar": "سُوْرَةُ الْعَصْرِ",
        "surah_name_translation": "The Declining Day, Epoch",
        "ayah_number": 3,
        "juz": 30,
        "revelation_type": "Mecca"
      },
      "arabic_word_count": 9,
      "translations": {
        "ar": {
          "text": "إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ وَتَوَاصَوۡاْ بِٱلۡحَقِّ وَتَوَاصَوۡاْ بِٱلصَّبۡرِ",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "except those who have faith, do good, and urge each other to the truth, and urge each other to perseverance",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "惟信道而且行善，并以真理相劝，以坚忍相勉的人则不然。",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "सिवाय उन लोगों के जो ईमान लाए और अच्छे कर्म किए और एक-दूसरे को हक़ की ताकीद की, और एक-दूसरे को धैर्य की ताकीद की",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "excepto aquellos que crean, obren rectamente, y se aconsejen mutuamente con la verdad y con la paciencia [ante las adversidades]",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "sauf ceux qui croient et accomplissent les bonnes œuvres, s'enjoignent mutuellement la vérité et s'enjoignent mutuellement l'endurance",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "কিন্তু তারা নয়, যারা বিশ্বাস স্থাপন করে ও সৎকর্ম করে এবং পরস্পরকে তাকীদ করে সত্যের এবং তাকীদ করে সবরের।",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "Exceto aos que crêem e fazem as boas obras e se recomendam mutuamente a verdade, e se recomendam mutuamente a paciência",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "кроме тех, которые уверовали, совершали праведные деяния, заповедали друг другу истину и заповедали друг другу терпение",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "مگر وہ لوگ جو ایمان لائے اور نیک عمل کرتے رہے اور آپس میں حق (بات) کی تلقین اور صبر کی تاکید کرتے رہے",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    }
  ]
}