{
  "surah": 88,
  "verses": [
    {
      "content_id": "quran_088_001",
      "reference": {
        "surah_number": 88,
        "surah_name": "Al-Ghaashiya",
        "surah_name_ar": "سُوْرَةُ الْغَاشِيَةِ",
        "surah_name_translation": "The Overwhelming",
        "ayah_number": 1,
        "juz": 30,
        "revelation_type": "Mecca"
      },
      "arabic_word_count": 4,
      "translations": {
        "ar": {
          "text": "هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡغَٰشِيَةِ",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "Has the news of the Overwhelming Event reached you ˹O Prophet˺",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "大灾的消息，确已降临你了，",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "क्या तुम्हें उस छा जानेवाली की ख़बर पहुँची है",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "¿Te ha llegado la historia sobre el día que todo lo alcanza",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "T'est-il parvenu le récit de l'enveloppante",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "আপনার কাছে আচ্ছন্নকারী কেয়ামতের বৃত্তান্ত পৌঁছেছে কি?",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "Chegou-te o relato da Envolvente",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "Дошел ли до тебя рассказ о Покрывающем (Дне воскресения)",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "بھلا تم کو ڈھانپ لینے والی (یعنی قیامت کا) حال معلوم ہوا ہے",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_088_002",
      "reference": {
        "surah_number": 88,
        "surah_name": "Al-Ghaashiya",
        "surah_name_ar": "سُوْرَةُ الْغَاشِيَةِ",
        "surah_name_translation": "The Overwhelming",
        "ayah_number": 2,
        "juz": 30,
        "revelation_type": "Mecca"
      },
      "arabic_word_count": 3,
      "translations": {
        "ar": {
          "text": "وُجُوهࣱ يَوۡمَئِذٍ خَٰشِعَةٌ",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "On that Day ˹some˺ faces will be downcast",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "在那日，将有许多人，是恭敬的、",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "उस दिन कितने ही चेहरे गिरे हुए होंगे",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "Ese día los rostros [de los condenados al Fuego] se verán humillados",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "Ce jour-là, il y aura des visages humiliés",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "অনেক মুখমন্ডল সেদিন হবে লাঞ্ছিত,",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "Nesse dia, haverá faces humilhadas",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "Одни лица в тот день будут унижены",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "اس روز بہت سے منہ (والے) ذلیل ہوں گے",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_088_003",
      "reference": {
        "surah_number": 88,
        "surah_name": "Al-Ghaashiya",
        "surah_name_ar": "سُوْرَةُ الْغَاشِيَةِ",
        "surah_name_translation": "The Overwhelming",
        "ayah_number": 3,
        "juz": 30,
        "revelation_type": "Mecca"
      },
      "arabic_word_count": 2,
      "translations": {
        "ar": {
          "text": "عَامِلَةࣱ نَّاصِبَةࣱ‏",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "˹totally˺ overburdened, exhausted",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "劳动的、辛苦的，",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "कठिन परिश्रम में पड़े, थके-हारे",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "abatidos y asfixiados",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "préoccupés, harassés",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "ক্লিষ্ট, ক্লান্ত।",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "Preocupadas, fatigadas",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "изнурены и утомлены",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "سخت محنت کرنے والے تھکے ماندے",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_088_004",
      "reference": {
        "surah_number": 88,
        "surah_name": "Al-Ghaashiya",
        "surah_name_ar": "سُوْرَةُ الْغَاشِيَةِ",
        "surah_name_translation": "The Overwhelming",
        "ayah_number": 4,
        "juz": 30,
        "revelation_type": "Mecca"
      },
      "arabic_word_count": 3,
      "translations": {
        "ar": {
          "text": "تَصۡلَىٰ نَارًا حَامِيَةࣰ‏",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "burning in a scorching Fire",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "他们将入烈火，",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "दहकती आग में प्रवेश करेंगे",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "Serán llevados a un fuego intenso",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "Ils brûleront dans un Feu ardent",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "তারা জ্বলন্ত আগুনে পতিত হবে।",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "Queimar-se-ão em um Fogo incandescente",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "Они войдут в Огонь жаркий",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "دہکتی آگ میں داخل ہوں گے",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_088_005",
      "reference": {
        "surah_number": 88,
        "surah_name": "Al-Ghaashiya",
        "surah_name_ar": "سُوْرَةُ الْغَاشِيَةِ",
        "surah_name_translation": "The Overwhelming",
        "ayah_number": 5,
        "juz": 30,
        "revelation_type": "Mecca"
      },
      "arabic_word_count": 4,
      "translations": {
        "ar": {
          "text": "تُسۡقَىٰ مِنۡ عَيۡنٍ ءَانِيَةࣲ‏",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "left to drink from a scalding spring",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "将饮沸泉，",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "खौलते हुए स्रोत से पिएँगे",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "donde les será dado a beber de una fuente de agua hirviente",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "et seront abreuvés d'une source bouillante",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "তাদেরকে ফুটন্ত নহর থেকে পান করানো হবে।",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "Dar-se-lhes-á de beber de escaldante fonte",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "Их будут поить из источника кипящего",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "ایک کھولتے ہوئے چشمے کا ان کو پانی پلایا جائے گا",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_088_006",
      "reference": {
        "surah_number": 88,
        "surah_name": "Al-Ghaashiya",
        "surah_name_ar": "سُوْرَةُ الْغَاشِيَةِ",
        "surah_name_translation": "The Overwhelming",
        "ayah_number": 6,
        "juz": 30,
        "revelation_type": "Mecca"
      },
      "arabic_word_count": 6,
      "translations": {
        "ar": {
          "text": "لَّيۡسَ لَهُمۡ طَعَامٌ إِلَّا مِن ضَرِيعࣲ‏",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "They will have no food except a foul, thorny shrub",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "他们没有食物，但有荆棘，",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "उनके लिए कोई खाना न होगा सिवाय एक प्रकार के ज़री के",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "No tendrán otra comida más que espinas",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "Il n'y aura pour eux d'autre nourriture que des plantes épineuses [darî]",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "কন্টকপূর্ণ ঝাড় ব্যতীত তাদের জন্যে কোন খাদ্য নেই।",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "Para eles, não haverá alimento, senão o de uma árvore seca esinhosa",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "и кормить только ядовитыми колючками",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "اور خار دار جھاڑ کے سوا ان کے لیے کوئی کھانا نہیں (ہو گا)",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_088_007",
      "reference": {
        "surah_number": 88,
        "surah_name": "Al-Ghaashiya",
        "surah_name_ar": "سُوْرَةُ الْغَاشِيَةِ",
        "surah_name_translation": "The Overwhelming",
        "ayah_number": 7,
        "juz": 30,
        "revelation_type": "Mecca"
      },
      "arabic_word_count": 6,
      "translations": {
        "ar": {
          "text": "لَّا يُسۡمِنُ وَلَا يُغۡنِي مِن جُوعࣲ‏",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "neither nourishing nor satisfying hunger",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "既不能肥人，又不能充饥；",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "जो न पुष्ट करे और न भूख मिटाए",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "que no alimentan ni sacian",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "qui n'engraisse, ni n'apaise la faim",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "এটা তাদেরকে পুষ্ট করবে না এবং ক্ষুধায়ও উপকার করবে না।",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "Que não engorda e de nada vale contra a fome",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "от которых не поправляются и которые не утоляют голода",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "جو نہ فربہی لائے اور نہ بھوک میں کچھ کام آئے",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_088_008",
      "reference": {
        "surah_number": 88,
        "surah_name": "Al-Ghaashiya",
        "surah_name_ar": "سُوْرَةُ الْغَاشِيَةِ",
        "surah_name_translation": "The Overwhelming",
        "ayah_number": 8,
        "juz": 30,
        "revelation_type": "Mecca"
      },
      "arabic_word_count": 3,
      "translations": {
        "ar": {
          "text": "وُجُوهࣱ يَوۡمَئِذࣲ نَّاعِمَةࣱ‏",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "On that Day ˹other˺ faces will be glowing with bliss",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "在那日，将有许多人，是享福的，",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "उस दिन कितने ही चेहरे प्रफुल्लित और सौम्य होंगे",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "Pero ese día los rostros [de los bienaventurados] estarán radiantes de felicidad",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "Ce jour-là, il y aura des visages épanouis",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "অনেক মুখমন্ডল সেদিন হবে, সজীব,",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "Nesse dia, haverá faces cheias de graça",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "Другие же лица в тот день будут радостны",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "اور بہت سے منہ (والے) اس روز شادماں ہوں گے",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_088_009",
      "reference": {
        "surah_number": 88,
        "surah_name": "Al-Ghaashiya",
        "surah_name_ar": "سُوْرَةُ الْغَاشِيَةِ",
        "surah_name_translation": "The Overwhelming",
        "ayah_number": 9,
        "juz": 30,
        "revelation_type": "Mecca"
      },
      "arabic_word_count": 2,
      "translations": {
        "ar": {
          "text": "لِّسَعۡيِهَا رَاضِيَةࣱ‏",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "˹fully˺ pleased with their striving",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "是为其劳绩而愉快的，",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "अपने प्रयास पर प्रसन्न",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "Estarán complacidos de sus obras",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "contents de leurs efforts",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "তাদের কর্মের কারণে সন্তুষ্ট।",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "Agradadas de seu esforço",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "Они будут довольны своими стараниями",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "اپنے اعمال (کی جزا) سے خوش دل",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_088_010",
      "reference": {
        "surah_number": 88,
        "surah_name": "Al-Ghaashiya",
        "surah_name_ar": "سُوْرَةُ الْغَاشِيَةِ",
        "surah_name_translation": "The Overwhelming",
        "ayah_number": 10,
        "juz": 30,
        "revelation_type": "Mecca"
      },
      "arabic_word_count": 3,
      "translations": {
        "ar": {
          "text": "فِي جَنَّةٍ عَالِيَةࣲ‏",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "in an elevated Garden",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "他们将在崇高的乐园中，",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "उच्च जन्नत में",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "Morarán en un jardín sublime",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "dans un haut Jardin",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "তারা থাকবে, সুউচ্চ জান্নাতে।",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "Estarão em um alto Jardim",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "в Вышних садах",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "بہشت بریں میں",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_088_011",
      "reference": {
        "surah_number": 88,
        "surah_name": "Al-Ghaashiya",
        "surah_name_ar": "سُوْرَةُ الْغَاشِيَةِ",
        "surah_name_translation": "The Overwhelming",
        "ayah_number": 11,
        "juz": 30,
        "revelation_type": "Mecca"
      },
      "arabic_word_count": 4,
      "translations": {
        "ar": {
          "text": "لَّا تَسۡمَعُ فِيهَا لَٰغِيَةࣰ‏",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "where no idle talk will be heard",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "听不到恶言，",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "जिसमें कोई व्यर्थ बात न सुनेंगे",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "en el que no oirán palabras vanas",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "où ils n'entendent aucune futilité",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "তথায় শুনবে না কোন অসার কথাবার্তা।",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "Nele, tu não ouvirás frivolidade alguma",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "Они не услышат там словоблудия",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "وہاں کسی طرح کی بکواس نہیں سنیں گے",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_088_012",
      "reference": {
        "surah_number": 88,
        "surah_name": "Al-Ghaashiya",
        "surah_name_ar": "سُوْرَةُ الْغَاشِيَةِ",
        "surah_name_translation": "The Overwhelming",
        "ayah_number": 12,
        "juz": 30,
        "revelation_type": "Mecca"
      },
      "arabic_word_count": 3,
      "translations": {
        "ar": {
          "text": "فِيهَا عَيۡنࣱ جَارِيَةࣱ‏",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "In it will be a running spring",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "里面有流泉，",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "उसमें स्रोत प्रवाहित होगा",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "En él habrá manantiales",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "Là, il y aura une source coulante",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "তথায় থাকবে প্রবাহিত ঝরণা।",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "Nele, haverá uma fonte corrente",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "Там есть источник текущий",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "اس میں چشمے بہ رہے ہوں گے",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_088_013",
      "reference": {
        "surah_number": 88,
        "surah_name": "Al-Ghaashiya",
        "surah_name_ar": "سُوْرَةُ الْغَاشِيَةِ",
        "surah_name_translation": "The Overwhelming",
        "ayah_number": 13,
        "juz": 30,
        "revelation_type": "Mecca"
      },
      "arabic_word_count": 3,
      "translations": {
        "ar": {
          "text": "فِيهَا سُرُرࣱ مَّرۡفُوعَةࣱ‏",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "along with thrones raised high",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "里面有高榻，",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "उसमें ऊँची-ऊँची मसनदें होगी",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "lechos elevados",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "Là, des divans élevés",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "তথায় থাকবে উন্নত সুসজ্জিত আসন।",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "Nele, haverá leitos elevados",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "Там воздвигнуты ложа",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "وہاں تخت ہوں گے اونچے بچھے ہوئے",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_088_014",
      "reference": {
        "surah_number": 88,
        "surah_name": "Al-Ghaashiya",
        "surah_name_ar": "سُوْرَةُ الْغَاشِيَةِ",
        "surah_name_translation": "The Overwhelming",
        "ayah_number": 14,
        "juz": 30,
        "revelation_type": "Mecca"
      },
      "arabic_word_count": 2,
      "translations": {
        "ar": {
          "text": "وَأَكۡوَابࣱ مَّوۡضُوعَةࣱ‏",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "and cups set at hand",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "有陈设著的杯盏，",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "प्याले ढंग से रखे होंगे",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "copas al alcance de su mano",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "et des coupes posées",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "এবং সংরক্ষিত পানপাত্র",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "E copos dispostos",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "расставлены чаши",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "اور آبخورے (قرینے سے) رکھے ہوئے",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_088_015",
      "reference": {
        "surah_number": 88,
        "surah_name": "Al-Ghaashiya",
        "surah_name_ar": "سُوْرَةُ الْغَاشِيَةِ",
        "surah_name_translation": "The Overwhelming",
        "ayah_number": 15,
        "juz": 30,
        "revelation_type": "Mecca"
      },
      "arabic_word_count": 2,
      "translations": {
        "ar": {
          "text": "وَنَمَارِقُ مَصۡفُوفَةࣱ‏",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "and ˹fine˺ cushions lined up",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "有排列著的靠枕，",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "क्रम से गाव तकिए लगे होंगे",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "cojines alineados",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "et des coussins rangés",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "এবং সারি সারি গালিচা",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "E almofadas enfileiradas",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "разложены подушки",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "اور گاؤ تکیے قطار کی قطار لگے ہوئے",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_088_016",
      "reference": {
        "surah_number": 88,
        "surah_name": "Al-Ghaashiya",
        "surah_name_ar": "سُوْرَةُ الْغَاشِيَةِ",
        "surah_name_translation": "The Overwhelming",
        "ayah_number": 16,
        "juz": 30,
        "revelation_type": "Mecca"
      },
      "arabic_word_count": 2,
      "translations": {
        "ar": {
          "text": "وَزَرَابِيُّ مَبۡثُوثَةٌ",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "and ˹splendid˺ carpets spread out",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "有铺展开的绒毯。",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "और हर ओर क़ालीने बिछी होंगी",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "y alfombras extendidas",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "et des tapis étalés",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "এবং বিস্তৃত বিছানো কার্পেট।",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "E tapetes espalhados",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "и разостланы ковры",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "اور نفیس مسندیں بچھی ہوئی",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_088_017",
      "reference": {
        "surah_number": 88,
        "surah_name": "Al-Ghaashiya",
        "surah_name_ar": "سُوْرَةُ الْغَاشِيَةِ",
        "surah_name_translation": "The Overwhelming",
        "ayah_number": 17,
        "juz": 30,
        "revelation_type": "Mecca"
      },
      "arabic_word_count": 6,
      "translations": {
        "ar": {
          "text": "أَفَلَا يَنظُرُونَ إِلَى ٱلۡإِبِلِ كَيۡفَ خُلِقَتۡ",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "Do they not ever reflect on camels—how they were ˹masterfully˺ created",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "难道他们不观察吗？骆驼是怎样造成的，",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "फिर क्या वे ऊँट की ओर नहीं देखते कि कैसा बनाया गया",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "¿Acaso no reflexionan [los que niegan la verdad] en la maravillosa creación del camello",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "Ne considèrent-ils donc pas les chameaux, comment ils ont été créés",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "তারা কি উষ্ট্রের প্রতি লক্ষ্য করে না যে, তা কিভাবে সৃষ্টি করা হয়েছে?",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "E não olham eles aos camelos, como foram criados",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "Неужели они не видят, как созданы верблюды",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "یہ لوگ اونٹوں کی طرف نہیں دیکھتے کہ کیسے (عجیب) پیدا کیے گئے ہیں",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_088_018",
      "reference": {
        "surah_number": 88,
        "surah_name": "Al-Ghaashiya",
        "surah_name_ar": "سُوْرَةُ الْغَاشِيَةِ",
        "surah_name_translation": "The Overwhelming",
        "ayah_number": 18,
        "juz": 30,
        "revelation_type": "Mecca"
      },
      "arabic_word_count": 4,
      "translations": {
        "ar": {
          "text": "وَإِلَى ٱلسَّمَآءِ كَيۡفَ رُفِعَتۡ",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "and the sky—how it was raised ˹high˺",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "天是怎样升高的，",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "और आकाश की ओर कि कैसा ऊँचा किया गया",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "En el cielo, cómo ha sido elevado",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "et le ciel comment il est élevé",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "এবং আকাশের প্রতি লক্ষ্য করে না যে, তা কিভাবে উচ্চ করা হয়েছে?",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "E ao céu, como foi elevado",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "как вознесено небо",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "اور آسمان کی طرف کہ کیسا بلند کیا گیا ہے",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_088_019",
      "reference": {
        "surah_number": 88,
        "surah_name": "Al-Ghaashiya",
        "surah_name_ar": "سُوْرَةُ الْغَاشِيَةِ",
        "surah_name_translation": "The Overwhelming",
        "ayah_number": 19,
        "juz": 30,
        "revelation_type": "Mecca"
      },
      "arabic_word_count": 4,
      "translations": {
        "ar": {
          "text": "وَإِلَى ٱلۡجِبَالِ كَيۡفَ نُصِبَتۡ",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "and the mountains—how they were firmly set up",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "山峦是怎样竖起的，",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "और पहाड़ो की ओर कि कैसे खड़े किए गए",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "En las montañas, cómo han sido afirmadas",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "et les montagnes comment elles sont dressées",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "এবং পাহাড়ের দিকে যে, তা কিভাবে স্থাপন করা হয়েছে?",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "E às montanhas, como foram armadas",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "как водружены горы",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "اور پہاڑوں کی طرف کہ کس طرح کھڑے کیے گئے ہیں",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_088_020",
      "reference": {
        "surah_number": 88,
        "surah_name": "Al-Ghaashiya",
        "surah_name_ar": "سُوْرَةُ الْغَاشِيَةِ",
        "surah_name_translation": "The Overwhelming",
        "ayah_number": 20,
        "juz": 30,
        "revelation_type": "Mecca"
      },
      "arabic_word_count": 4,
      "translations": {
        "ar": {
          "text": "وَإِلَى ٱلۡأَرۡضِ كَيۡفَ سُطِحَتۡ",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "and the earth—how it was levelled out",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "大地是怎样展开的。",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "और धरती की ओर कि कैसी बिछाई गई",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "Y en la Tierra, cómo ha sido extendida",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "et la terre comment elle est nivelée",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "এবং পৃথিবীর দিকে যে, তা কিভাবে সমতল বিছানো হয়েছে?",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "E à terra, como foi distendida",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "как распростерта земля",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "اور زمین کی طرف کہ کس طرح بچھائی گئی",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_088_021",
      "reference": {
        "surah_number": 88,
        "surah_name": "Al-Ghaashiya",
        "surah_name_ar": "سُوْرَةُ الْغَاشِيَةِ",
        "surah_name_translation": "The Overwhelming",
        "ayah_number": 21,
        "juz": 30,
        "revelation_type": "Mecca"
      },
      "arabic_word_count": 4,
      "translations": {
        "ar": {
          "text": "فَذَكِّرۡ إِنَّمَآ أَنتَ مُذَكِّرࣱ‏",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "So, ˹continue to˺ remind ˹all, O Prophet˺, for your duty is only to remind",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "你当教诲，你只是教诲（他们的），",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "अच्छा तो नसीहत करो! तुम तो बस एक नसीहत करनेवाले हो",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "Exhorta a la gente porque esa es tu misión",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "Eh bien, rappelle! Tu n'es qu'un rappeleur",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "অতএব, আপনি উপদেশ দিন, আপনি তো কেবল একজন উপদেশদাতা,",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "Então, lembra-lhes o Alcorão. És, apenas lembrador",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "Наставляй же, ведь ты - наставник",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "تو تم نصیحت کرتے رہو کہ تم نصیحت کرنے والے ہی ہو",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_088_022",
      "reference": {
        "surah_number": 88,
        "surah_name": "Al-Ghaashiya",
        "surah_name_ar": "سُوْرَةُ الْغَاشِيَةِ",
        "surah_name_translation": "The Overwhelming",
        "ayah_number": 22,
        "juz": 30,
        "revelation_type": "Mecca"
      },
      "arabic_word_count": 3,
      "translations": {
        "ar": {
          "text": "لَّسۡتَ عَلَيۡهِم بِمُصَيۡطِرٍ",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "You are not ˹there˺ to compel them ˹to believe˺",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "你绝不是监察他们的，",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "तुम उनपर कोई दरोग़ा नही हो",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "No puedes obligarlos a creer",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "et tu n'es pas un dominateur sur eux",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "আপনি তাদের শাসক নন,",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "Não és, sobre eles, dono absoluto",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "и ты не властен над ними",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "تم ان پر داروغہ نہیں ہو",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_088_023",
      "reference": {
        "surah_number": 88,
        "surah_name": "Al-Ghaashiya",
        "surah_name_ar": "سُوْرَةُ الْغَاشِيَةِ",
        "surah_name_translation": "The Overwhelming",
        "ayah_number": 23,
        "juz": 30,
        "revelation_type": "Mecca"
      },
      "arabic_word_count": 4,
      "translations": {
        "ar": {
          "text": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "But whoever turns away, persisting in disbelief",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "但谁转身离去而且不信道，",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "किन्तु जिस किसी ने मुँह फेरा और इनकार किया",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "Pero sabe que a quien dé la espalda y rechace la verdad",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "Sauf celui qui tourne le dos et ne croit pas",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "কিন্তু যে মুখ ফিরিয়ে নেয় ও কাফের হয়ে যায়,",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "Mas a quem volta as costas e renega a Fé",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "А тех, кто отвернется и не уверует",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "ہاں جس نے منہ پھیرا اور نہ مانا",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_088_024",
      "reference": {
        "surah_number": 88,
        "surah_name": "Al-Ghaashiya",
        "surah_name_ar": "سُوْرَةُ الْغَاشِيَةِ",
        "surah_name_translation": "The Overwhelming",
        "ayah_number": 24,
        "juz": 30,
        "revelation_type": "Mecca"
      },
      "arabic_word_count": 4,
      "translations": {
        "ar": {
          "text": "فَيُعَذِّبُهُ ٱللَّهُ ٱلۡعَذَابَ ٱلۡأَكۡبَرَ",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "then Allah will inflict upon them the major punishment",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "真主将以最大的刑罚惩治谁。",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "तो अल्लाह उसे बड़ी यातना देगा",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "Dios lo someterá al peor de los castigos",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "alors Allah le châtiera du plus grand châtiment",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "আল্লাহ তাকে মহা আযাব দেবেন।",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "Allah castigá-lo-á com o castigo maior",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "Аллах подвергнет величайшим мучениям",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "تو خدا اس کو بڑا عذاب دے گا",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_088_025",
      "reference": {
        "surah_number": 88,
        "surah_name": "Al-Ghaashiya",
        "surah_name_ar": "سُوْرَةُ الْغَاشِيَةِ",
        "surah_name_translation": "The Overwhelming",
        "ayah_number": 25,
        "juz": 30,
        "revelation_type": "Mecca"
      },
      "arabic_word_count": 3,
      "translations": {
        "ar": {
          "text": "إِنَّ إِلَيۡنَآ إِيَابَهُمۡ",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "Surely to Us is their return",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "他们必定只归於我，",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "निस्संदेह हमारी ओर ही है उनका लौटना",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "Porque todos comparecerán ante Mí",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "Vers Nous est leur retour",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "নিশ্চয় তাদের প্রত্যাবর্তন আমারই নিকট,",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "Por certo, a Nós será sua volta",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "К Нам они вернутся",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "بےشک ان کو ہمارے پاس لوٹ کر آنا ہے",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_088_026",
      "reference": {
        "surah_number": 88,
        "surah_name": "Al-Ghaashiya",
        "surah_name_ar": "سُوْرَةُ الْغَاشِيَةِ",
        "surah_name_translation": "The Overwhelming",
        "ayah_number": 26,
        "juz": 30,
        "revelation_type": "Mecca"
      },
      "arabic_word_count": 4,
      "translations": {
        "ar": {
          "text": "ثُمَّ إِنَّ عَلَيۡنَا حِسَابَهُم",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "then surely with Us is their reckoning",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "他们的稽核，必定由我负责。",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "फिर हमारे ही ज़िम्मे है उनका हिसाब लेना",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "y seré Yo Quien los juzgue",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "Ensuite, c'est à Nous de leur demander compte",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "অতঃপর তাদের হিসাব-নিকাশ আমারই দায়িত্ব।",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "Em seguida, por certo, impender-Nos-á sua conta",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "и затем Мы потребуем у них отчета",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "پھر ہم ہی کو ان سے حساب لینا ہے",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    }
  ]
}