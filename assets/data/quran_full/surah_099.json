{
  "surah": 99,
  "verses": [
    {
      "content_id": "quran_099_001",
      "reference": {
        "surah_number": 99,
        "surah_name": "Az-Zalzala",
        "surah_name_ar": "سُوْرَةُ الزِّلْزَالِ",
        "surah_name_translation": "The Earthquake",
        "ayah_number": 1,
        "juz": 30,
        "revelation_type": "Madina"
      },
      "arabic_word_count": 4,
      "translations": {
        "ar": {
          "text": "إِذَا زُلۡزِلَتِ ٱلۡأَرۡضُ زِلۡزَالَهَا",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "When the earth is shaken ˹in˺ its ultimate quaking",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "当大地猛烈地震动",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "जब धरती इस प्रकार हिला डाली जाएगी जैसा उसे हिलाया जाना है",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "Cuando la Tierra sea sacudida por el gran terremoto",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "Quand la terre tremblera d'un violent tremblement",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "যখন পৃথিবী তার কম্পনে প্রকম্পিত হবে,",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "Quando a terra for tremida por seu tremor",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "Когда земля содрогнется от сотрясений",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "جب زمین بھونچال سے ہلا دی جائے گی",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_099_002",
      "reference": {
        "surah_number": 99,
        "surah_name": "Az-Zalzala",
        "surah_name_ar": "سُوْرَةُ الزِّلْزَالِ",
        "surah_name_translation": "The Earthquake",
        "ayah_number": 2,
        "juz": 30,
        "revelation_type": "Madina"
      },
      "arabic_word_count": 3,
      "translations": {
        "ar": {
          "text": "وَأَخۡرَجَتِ ٱلۡأَرۡضُ أَثۡقَالَهَا",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "and when the earth throws out ˹all˺ its contents",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "抛其重担",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "और धरती अपने बोझ बाहर निकाल देगी",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "y expulse su carga [haciendo surgir a los muertos de sus tumbas]",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "et que la terre fera sortir ses fardeaux",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "যখন সে তার বোঝা বের করে দেবে।",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "E a terra fizer sair seus pesos",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "когда земля извергнет свою ношу",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "اور زمین اپنے (اندر) کے بوجھ نکال ڈالے گی",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_099_003",
      "reference": {
        "surah_number": 99,
        "surah_name": "Az-Zalzala",
        "surah_name_ar": "سُوْرَةُ الزِّلْزَالِ",
        "surah_name_translation": "The Earthquake",
        "ayah_number": 3,
        "juz": 30,
        "revelation_type": "Madina"
      },
      "arabic_word_count": 4,
      "translations": {
        "ar": {
          "text": "وَقَالَ ٱلۡإِنسَٰنُ مَا لَهَا",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "and humanity cries, “What is wrong with it?”—",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "说大地怎麽啦",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "और मनुष्य कहेगा, \"उसे क्या हो गया है",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "y el hombre diga: \"¿Qué le sucede a la Tierra",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "et que l'homme dira: «Qu'a-t-elle?»",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "এবং মানুষ বলবে, এর কি হল ?",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "E o ser humano disser: \"O que há com ela",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "и человек спросит, что же с нею",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "اور انسان کہے گا کہ اس کو کیا ہوا ہے؟",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_099_004",
      "reference": {
        "surah_number": 99,
        "surah_name": "Az-Zalzala",
        "surah_name_ar": "سُوْرَةُ الزِّلْزَالِ",
        "surah_name_translation": "The Earthquake",
        "ayah_number": 4,
        "juz": 30,
        "revelation_type": "Madina"
      },
      "arabic_word_count": 3,
      "translations": {
        "ar": {
          "text": "يَوۡمَئِذࣲ تُحَدِّثُ أَخۡبَارَهَا",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "on that Day the earth will recount everything",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "在那日, 大地将报告它的消息。",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "उस दिन वह अपना वृत्तांत सुनाएगी",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "Ese día, la Tierra dará testimonio de todo cuanto sucedió sobre ella",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "ce jour-là, elle contera son histoire",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "সেদিন সে তার বৃত্তান্ত বর্ণনা করবে,",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "Nesse dia, ela contará suas notícias",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "в тот день она расскажет свои известия",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "اس روز وہ اپنے حالات بیان کردے گی",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_099_005",
      "reference": {
        "surah_number": 99,
        "surah_name": "Az-Zalzala",
        "surah_name_ar": "سُوْرَةُ الزِّلْزَالِ",
        "surah_name_translation": "The Earthquake",
        "ayah_number": 5,
        "juz": 30,
        "revelation_type": "Madina"
      },
      "arabic_word_count": 4,
      "translations": {
        "ar": {
          "text": "بِأَنَّ رَبَّكَ أَوۡحَىٰ لَهَا",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "having been inspired by your Lord ˹to do so˺",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "因为你的主已启示了它",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "इस कारण कि तुम्हारे रब ने उसे यही संकेत किया होगा",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "por orden de su Señor",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "selon ce que ton Seigneur lui aura révélé [ordonné]",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "কারণ, আপনার পালনকর্তা তাকে আদেশ করবেন।",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "Conforme seu Senhor lho inspirou",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "потому что Господь твой внушит ей это",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "کیونکہ تمہارے پروردگار نے اس کو حکم بھیجا (ہوگا)",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_099_006",
      "reference": {
        "surah_number": 99,
        "surah_name": "Az-Zalzala",
        "surah_name_ar": "سُوْرَةُ الزِّلْزَالِ",
        "surah_name_translation": "The Earthquake",
        "ayah_number": 6,
        "juz": 30,
        "revelation_type": "Madina"
      },
      "arabic_word_count": 7,
      "translations": {
        "ar": {
          "text": "يَوۡمَئِذࣲ يَصۡدُرُ ٱلنَّاسُ أَشۡتَاتࣰ ا لِّيُرَوۡاْ أَعۡمَٰلَهُمۡ",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "On that Day people will proceed in separate groups to be shown ˹the consequences of˺ their deeds",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "在那日, 人们将纷纷地离散",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "उस दिन लोग अलग-अलग निकलेंगे, ताकि उन्हें कर्म दिखाए जाएँ",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "Entonces, los seres humanos acudirán al Día del Juicio en grupos para conocer el resultado de sus obras",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "Ce jour-là, les gens sortiront séparément pour que leur soient montrées leurs œuvres",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "সেদিন মানুষ বিভিন্ন দলে প্রকাশ পাবে, যাতে তাদেরকে তাদের কৃতকর্ম দেখানো হয়।",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "Nesse dia os humanos camparecerão, separadamente, para os fazerem ver suas obras",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "В тот день люди выйдут толпами, чтобы им показали их деяния",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "اس دن لوگ گروہ گروہ ہو کر آئیں گے تاکہ ان کو ان کے اعمال دکھا دیئے جائیں",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_099_007",
      "reference": {
        "surah_number": 99,
        "surah_name": "Az-Zalzala",
        "surah_name_ar": "سُوْرَةُ الزِّلْزَالِ",
        "surah_name_translation": "The Earthquake",
        "ayah_number": 7,
        "juz": 30,
        "revelation_type": "Madina"
      },
      "arabic_word_count": 7,
      "translations": {
        "ar": {
          "text": "فَمَن يَعۡمَلۡ مِثۡقَالَ ذَرَّةٍ خَيۡرࣰ ا يَرَهُۥ",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "So whoever does an atom’s weight of good will see it",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "以便他们得见自己行为的报应。",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "अतः जो कोई कणभर भी नेकी करेगा, वह उसे देख लेगा",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "Quien haya realizado una obra de bien, tan pequeña como un átomo, la encontrará registrada",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "Quiconque fait un bien fût-ce du poids d'un atome, le verra",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "অতঃপর কেউ অণু পরিমাণ সৎকর্ম করলে তা দেখতে পাবে",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "Então quem houver feito um peso de àtomo de bem o verá",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "Тот, кто сделал добро весом в мельчайшую частицу, увидит его",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "تو جس نے ذرہ بھر نیکی کی ہو گی وہ اس کو دیکھ لے گا",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    },
    {
      "content_id": "quran_099_008",
      "reference": {
        "surah_number": 99,
        "surah_name": "Az-Zalzala",
        "surah_name_ar": "سُوْرَةُ الزِّلْزَالِ",
        "surah_name_translation": "The Earthquake",
        "ayah_number": 8,
        "juz": 30,
        "revelation_type": "Madina"
      },
      "arabic_word_count": 7,
      "translations": {
        "ar": {
          "text": "وَمَن يَعۡمَلۡ مِثۡقَالَ ذَرَّةࣲ شَرࣰّ ا يَرَهُۥ",
          "translator": "Original Arabic revelation"
        },
        "en": {
          "text": "And whoever does an atom’s weight of evil will see it",
          "translator": "Dr. Mustafa Khattab"
        },
        "zh": {
          "text": "行一个小蚂蚁重的善事者, 将见其善报; 作一个小蚂蚁重的恶事者, 将见其恶报。",
          "translator": "Ma Jian (马坚)"
        },
        "hi": {
          "text": "और जो कोई कणभर भी बुराई करेगा, वह भी उसे देख लेगा",
          "translator": "Muhammad Farooq Khan & Muhammad Ahmed"
        },
        "es": {
          "text": "Y quien haya realizado una mala obra, tan pequeña como un átomo, la encontrará registrada",
          "translator": "Muhammad Isa Garcia"
        },
        "fr": {
          "text": "et quiconque fait un mal fût-ce du poids d'un atome, le verra",
          "translator": "Muhammad Hamidullah"
        },
        "bn": {
          "text": "এবং কেউ অণু পরিমাণ অসৎকর্ম করলে তাও দেখতে পাবে।",
          "translator": "Maulana Muhiuddin Khan",
          "source": "Tanzil (tanzil.net/trans/bn.bengali)"
        },
        "pt": {
          "text": "E quem houver feito um peso de átomo de mal o verá",
          "translator": "Helmi Nasr"
        },
        "ru": {
          "text": "И тот, кто сделал зло весом в мельчайшую частицу, увидит его",
          "translator": "Elmir Kuliev"
        },
        "ur": {
          "text": "اور جس نے ذرہ بھر برائی کی ہوگی وہ اسے دیکھ لے گا",
          "translator": "Fateh Muhammad Jalandhry"
        }
      }
    }
  ]
}